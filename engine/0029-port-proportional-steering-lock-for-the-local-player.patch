From 7a9a1ed571b7c621dfcc448c8cce804f69a05f5d Mon Sep 17 00:00:00 2001
From: caesarsol <smilemachine@gmail.com>
Date: Mon, 2 Nov 2026 14:15:12 +0000
Subject: [PATCH] port: proportional steering lock for the local player's car
 (GTA2 Mobile soft zone)

---
 Source/CarPhysics_B0.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/Source/CarPhysics_B0.cpp b/Source/CarPhysics_B0.cpp
index 5dbd93e6..6aaec716 100644
--- a/Source/CarPhysics_B0.cpp
+++ b/Source/CarPhysics_B0.cpp
@@ -1,5 +1,9 @@
 // This TU's copy of the Fix16_Point length zero (see Fix16_Point.hpp)
 #define FIX16_POINT_ZERO kFP16Zero_6FE20C
+#ifdef GTA2_PORT
+class Car_BC;
+extern "C" int Gta2Port_SteerScale(Car_BC* car);
+#endif
 
 #include "ped_death_cause.hpp"
 #include "explosion_type.hpp"
@@ -3399,6 +3403,15 @@ void CarPhysics_B0::UpdateSteeringAngle_562560()
         }
         field_78_pointing_ang_rad = GetScaledTurnRatio(v6 / (dword_6FE228 * dword_6FE104), field_AD_turn_direction);
     }
+#ifdef GTA2_PORT
+    // GTA2 Mobile: proportional steering for the local player's car. The port scales the wheel
+    // angle by scale / 256 (port/platform/steer_web.cpp); every other car gets 256 = full lock.
+    const int scale = Gta2Port_SteerScale(field_5C_pCar);
+    if (scale != 256)
+    {
+        field_78_pointing_ang_rad.mValue = (s32)(((__int64)field_78_pointing_ang_rad.mValue * scale) / 256);
+    }
+#endif
 }
 
 MATCH_FUNC(0x5626a0)
