diff --git a/port/platform/mobile_camera_web.cpp b/port/platform/mobile_camera_web.cpp
new file mode 100644
index 0000000..23bc91f
--- /dev/null
+++ b/port/platform/mobile_camera_web.cpp
@@ -0,0 +1,48 @@
+// GTA2 Mobile camera (mode 2) look-ahead.
+//
+// Mode 2 skips the original's car-velocity camera offset (patch 0026), which put the camera up
+// to ~4 blocks ahead of the car and raised it with speed, and pins the camera to its target
+// (Camera_0xBC::Update_435FF0) so the car stays centred at any speed. This optional look-ahead
+// moves the target along the velocity: lead = min(speed × k, max) blocks (k in ticks). Smooth in
+// speed, so no swaying; zero when stopped. Off by default (k = 0): the car is drawn centred.
+#include <emscripten.h>
+#include <math.h>
+#include "Car_BC.hpp"
+#include "Fix16_Point.hpp"
+
+extern "C" {
+float gGta2PortCameraLeadK = 0.0f;   // blocks of lead per block/tick of speed (ticks)
+float gGta2PortCameraLeadMax = 3.0f; // blocks
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_camera_lead(float k, float max)
+{
+    gGta2PortCameraLeadK = k < 0.0f ? 0.0f : k > 40.0f ? 40.0f : k;
+    gGta2PortCameraLeadMax = max < 0.0f ? 0.0f : max > 8.0f ? 8.0f : max;
+}
+
+// Called by Camera_0xBC::ApplyCarVelocityCameraOffset_436200 in mode 2 (patch 0026).
+void Gta2Port_MobileCameraLead(Car_BC* pCar, Fix16* pX, Fix16* pY)
+{
+    if (!pCar || pCar->IsTrainModel_403BA0() || gGta2PortCameraLeadK <= 0.0f)
+    {
+        return;
+    }
+    const Fix16_Point v = pCar->get_linvel_43A450(); // blocks per tick
+    const double kOne = 16384.0;                     // Fix16 1.0
+    const double vx = v.x.mValue / kOne;
+    const double vy = v.y.mValue / kOne;
+    const double len = sqrt(vx * vx + vy * vy);
+    if (len < 1e-4)
+    {
+        return;
+    }
+    double lead = len * gGta2PortCameraLeadK;
+    if (lead > gGta2PortCameraLeadMax)
+    {
+        lead = gGta2PortCameraLeadMax;
+    }
+    const double f = lead / len;
+    pX->mValue += static_cast<s32>(vx * f * kOne);
+    pY->mValue += static_cast<s32>(vy * f * kOne);
+}
+}
diff --git a/port/platform/steer_web.cpp b/port/platform/steer_web.cpp
new file mode 100644
index 0000000..6f23b48
--- /dev/null
+++ b/port/platform/steer_web.cpp
@@ -0,0 +1,285 @@
+// GTA2 Mobile: steer the local player's car toward a target heading inside the physics tick.
+//
+// The touch overlay's joystick gives a direction of travel, but the game only takes left /
+// right key states, and a car keeps yawing for a few ticks after the key is released (yaw
+// momentum). A controller outside the engine sees the heading a tick late and never the
+// angular velocity, so it hunts around the target. Here, once per tick and with the exact
+// state, the decision is: steer toward the target unless the momentum (angular velocity ×
+// kd ticks) already carries the car there, with a small dead band. Reversing cars have the
+// steering sense inverted, as the engine does for the keys.
+//
+// GTA2's steering is on/off at full lock (CarPhysics_B0::UpdateSteeringAngle_562560), so at
+// speed every correction is a full-lock jab and the car slides. Patch 0029 lets the port scale
+// the wheel angle of this car: inside a "soft zone" around the target the lock follows the
+// remaining (momentum-corrected) error, sqrt(|predicted| / ramp), full lock beyond. The square
+// root keeps authority near the target (a linear law left a slow creep over the last degrees)
+// while damping the first jab: measured at 0.38 blocks/tick with a 25° swerve, slip 4° instead
+// of 12° at full lock, same heading peak, settled in 0.7 s. The zone shrinks with speed (full
+// width from kSoftFullSpeed up, none at a standstill): slow cars do not slide, and a tight
+// manoeuvre still gets the whole lock.
+//
+// Grip (GTA1-style handling): once per tick the car's velocity is turned onto its heading
+// (same speed, same sense: forward or reversing), by grip/256 of the way. At 256 the car never
+// slides: it goes exactly where it points and keeps its speed through a turn, whatever the
+// handling data says about skidding. 0 = the original physics. Applied to the local player's
+// car whenever it is simulated, steering target or not (a coasting car would slide otherwise).
+//
+// Road steer assist: GTA2 snaps a car whose wheels are straight to the axis of the road it is
+// on (CarPhysics_B0::ApplyArrowSteerAssist_5626F0, within 25°). While a steering target is set
+// the assist is skipped for this car (Gta2Port_SteerAssistOff): the two fought a few degrees
+// off a road's axis (the assist pulls every tick the key is up, the override jabs back). With
+// the stick released the assist is back.
+//
+// Throttle: the joystick's distance caps the engine's analog gas pedal (field_60_gas_pedal,
+// 0..5, ramped by ApplyThrottleInput_562480) for this car: gta2_port_set_throttle(0..256) →
+// cap = full pedal × throttle / 256 (Gta2Port_ThrottleCap, patch 0028).
+//
+// gta2_port_set_steer_target(units): target heading in Ang16 units (0..1439, 4 per degree),
+// -1 = off (the keys steer as usual). gta2_port_set_steer_params(kd, band): momentum look-ahead
+// in ticks and dead band in Ang16 units. gta2_port_set_steer_ramp(units): soft zone width in
+// Ang16 units (0 = always full lock). gta2_port_set_steer_grip(g): velocity realignment per
+// tick, 0..256. gta2_port_set_throttle(t): gas pedal cap, 0..256.
+#include <emscripten.h>
+#include <math.h>
+#include "Car_BC.hpp"
+#include "CarInfo_808.hpp"
+#include "CarPhysics_B0.hpp"
+#include "Game_0x40.hpp"
+#include "Ped.hpp"
+#include "Player.hpp"
+#include "ang16.hpp"
+
+extern "C" {
+s32 gGta2PortSteerTarget = -1;
+s32 gGta2PortSteerKd = 2;     // ticks of momentum look-ahead
+s32 gGta2PortSteerBand = 6;   // stop steering within this (Ang16 units; 4 = 1°); restart beyond 2× it
+s32 gGta2PortSteerRamp = 120; // soft zone: lock = |predicted| / ramp while below it (Ang16 units; 120 = 30°)
+s32 gGta2PortSteerGrip = 256; // velocity turned onto the heading by grip/256 per tick (256 = never slides)
+s32 gGta2PortThrottle = 256;  // gas pedal cap, 0..256 of the full pedal
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_target(int units)
+{
+    gGta2PortSteerTarget = units < 0 ? -1 : ((units % 1440) + 1440) % 1440;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_params(int kd, int band)
+{
+    gGta2PortSteerKd = kd < 0 ? 0 : kd > 30 ? 30 : kd;
+    gGta2PortSteerBand = band < 0 ? 0 : band > 360 ? 360 : band;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_ramp(int units)
+{
+    gGta2PortSteerRamp = units < 0 ? 0 : units > 720 ? 720 : units;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_grip(int grip)
+{
+    gGta2PortSteerGrip = grip < 0 ? 0 : grip > 256 ? 256 : grip;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_throttle(int throttle)
+{
+    gGta2PortThrottle = throttle < 0 ? 0 : throttle > 256 ? 256 : throttle;
+}
+
+// Debug, 12 ints, refreshed once per tick for the local player's car (zeros otherwise):
+//  0 active (a steering target is set)   1 error (Ang16 units, + = turn left)
+//  2 angular velocity (units/tick)       3 key sent (-1/0/1)   4 lock scale (0..256)
+//  5 slip angle: velocity direction − heading, in the sense of travel (units, + = left)
+//  6 lateral velocity (Fix16 blocks/tick, + = left)   7 speed (Fix16 blocks/tick)
+//  8 front skid / threshold × 256   9 rear skid / threshold × 256 (≥ 256 = skidding)
+// 10 road assist correction applied last tick (units/tick)   11 gas pedal (Fix16, 0..5)
+// 5..11 are the physics' output of the previous tick, read before this tick's grip step.
+EMSCRIPTEN_KEEPALIVE const s32* gta2_port_steer_debug();
+}
+
+namespace
+{
+s32 gDebug[12];
+const s32 kFullScale = 256;
+const s32 kMinScale = 32;              // never below 1/8 lock (only reached with a very wide zone)
+const s32 kSoftFullSpeed = 16384 / 4;  // Fix16 blocks/tick (0.25): the soft zone is full from here up
+
+Car_BC* gScaledCar = nullptr; // the car whose wheel angle is scaled this tick
+s32 gScale = kFullScale;
+s32 gAssist = 0;              // road assist correction noted during the last physics update (Fix16 rad)
+
+s32 SkidRatio(const Fix16& skid, const Fix16& threshold)
+{
+    if (threshold.mValue <= 0)
+    {
+        return skid.mValue > 0 ? 256 : 0;
+    }
+    return (s32)(((__int64)skid.mValue * 256) / threshold.mValue);
+}
+
+Ped* LocalPlayerPed()
+{
+    if (!gGame_0x40_67E008 || !gGame_0x40_67E008->field_38_orf1)
+    {
+        return nullptr;
+    }
+    return gGame_0x40_67E008->field_38_orf1->field_2C4_player_ped;
+}
+} // namespace
+
+extern "C" const s32* gta2_port_steer_debug()
+{
+    return gDebug;
+}
+
+// Called from CarPhysics_B0::UpdateSteeringAngle_562560 (patch 0029): wheel angle scale /256.
+extern "C" int Gta2Port_SteerScale(Car_BC* car)
+{
+    return car && car == gScaledCar ? gScale : kFullScale;
+}
+
+namespace
+{
+bool IsLocalPlayerCar(Car_BC* car)
+{
+    if (!car || !car->field_58_physics)
+    {
+        return false;
+    }
+    Ped* local = LocalPlayerPed();
+    return local && local->get_car_416B60() == car;
+}
+} // namespace
+
+// Called from CarPhysics_B0::ApplyArrowSteerAssist_5626F0 (patch 0027): skip the road snap?
+extern "C" int Gta2Port_SteerAssistOff(Car_BC* car)
+{
+    return gGta2PortSteerTarget >= 0 && IsLocalPlayerCar(car) ? 1 : 0;
+}
+
+// Called from the same function with the correction it is about to apply (Fix16 radians).
+extern "C" void Gta2Port_NoteSteerAssist(Car_BC* car, int correction)
+{
+    if (IsLocalPlayerCar(car))
+    {
+        gAssist = correction;
+    }
+}
+
+// Called from CarPhysics_B0::ApplyThrottleInput_562480 (patch 0028): the gas pedal cap (Fix16).
+extern "C" int Gta2Port_ThrottleCap(Car_BC* car, int maxPedal)
+{
+    if (gGta2PortThrottle >= 256 || !IsLocalPlayerCar(car))
+    {
+        return maxPedal;
+    }
+    return (s32)(((__int64)maxPedal * gGta2PortThrottle) / 256);
+}
+
+// Called from Car_BC::HandleUserInput_4418D0 (patch 0027) before the keys are used.
+extern "C" void Gta2Port_SteerOverride(Car_BC* car, char* bLeftOn, char* bRightOn)
+{
+    gDebug[0] = 0;
+    gScaledCar = nullptr;
+    gScale = kFullScale;
+    if (!IsLocalPlayerCar(car))
+    {
+        return;
+    }
+    CarPhysics_B0* phys = car->field_58_physics;
+    // Reversing: the velocity points against the heading (the physics' own test).
+    bool reversing = false;
+    s32 speed = 0; // Fix16 blocks/tick
+    s32 slip = 0;  // Ang16 units, in the sense of travel
+    if (!phys->field_40_linvel_1.IsNull())
+    {
+        const Ang16 rel = phys->field_40_linvel_1.atan2_40F790() - phys->field_58_theta;
+        reversing = !(rel <= 360 || rel >= 1080);
+        speed = phys->field_40_linvel_1.GetLength_41E260().mValue;
+        slip = (((rel.rValue - (reversing ? 720 : 0)) % 1440 + 1440 + 720) % 1440) - 720;
+    }
+    // Previous tick's physics output, for the overlay's charts (before this tick's grip step).
+    {
+        const double th = phys->field_58_theta.rValue * (M_PI * 2 / 1440);
+        const Fix16_Point& v = phys->field_40_linvel_1;
+        // lateral = v × forward, forward = (sin θ, cos θ) in map coordinates; + = the car's left
+        gDebug[5] = slip;
+        gDebug[6] = (s32)(v.x.mValue * cos(th) - v.y.mValue * sin(th));
+        gDebug[7] = speed;
+        const CarInfo_2C* info = gCarInfo_808_678098 ? gCarInfo_808_678098->GetInfoAtIdx_454840(car->GetCarModelForPhysics_43A850()) : nullptr;
+        gDebug[8] = info ? SkidRatio(phys->field_84_front_skid, info->field_24_skid_threshhold_1) : 0;
+        gDebug[9] = info ? SkidRatio(phys->field_88_rear_skid, info->field_28_skid_threshhold_2) : 0;
+        gDebug[10] = gAssist / 71;
+        gDebug[11] = phys->field_60_gas_pedal.mValue;
+        gAssist = 0;
+    }
+    // Grip: turn the velocity onto the heading (see the top of the file).
+    if (gGta2PortSteerGrip > 0 && speed > 0)
+    {
+        const Ang16 sense((phys->field_58_theta.rValue + (reversing ? 720 : 0)) % 1440);
+        Fix16_Point aligned;
+        aligned.FromPolar_41E210(Fix16(speed, 0), sense);
+        Fix16_Point& v = phys->field_40_linvel_1;
+        v.x.mValue += (s32)(((__int64)(aligned.x.mValue - v.x.mValue) * gGta2PortSteerGrip) / 256);
+        v.y.mValue += (s32)(((__int64)(aligned.y.mValue - v.y.mValue) * gGta2PortSteerGrip) / 256);
+    }
+    if (gGta2PortSteerTarget < 0)
+    {
+        gDebug[1] = gDebug[2] = gDebug[3] = 0;
+        gDebug[4] = kFullScale;
+        return;
+    }
+    const s32 theta = phys->field_58_theta.rValue;
+    s32 error = gGta2PortSteerTarget - theta; // + = turn left (theta grows)
+    error = ((error + 720) % 1440 + 1440) % 1440 - 720;
+    const s32 omega = phys->field_74_ang_vel_rad.mValue / 71; // Ang16 units per tick
+    // Hysteresis: once the car has settled, small errors are left alone (a tick of steering
+    // always moves it more than the band), until the error grows to two bands.
+    static s32 steering = 0;
+    const s32 predicted = error - omega * gGta2PortSteerKd;
+    const s32 startBand = gGta2PortSteerBand * 2;
+    s32 decision = 0;
+    if (steering != 0)
+    {
+        if (predicted > gGta2PortSteerBand && steering > 0)
+        {
+            decision = 1;
+        }
+        else if (predicted < -gGta2PortSteerBand && steering < 0)
+        {
+            decision = -1;
+        }
+    }
+    else if (predicted > startBand)
+    {
+        decision = 1;
+    }
+    else if (predicted < -startBand)
+    {
+        decision = -1;
+    }
+    steering = decision;
+    // Soft zone: lock = sqrt(|predicted| / ramp) inside ramp × (speed / kSoftFullSpeed, at most 1).
+    s32 scale = kFullScale;
+    if (decision != 0 && gGta2PortSteerRamp > 0 && speed > 0)
+    {
+        const s32 mag = predicted < 0 ? -predicted : predicted;
+        const s32 ramp = speed >= kSoftFullSpeed ? gGta2PortSteerRamp
+                                                  : (s32)((__int64)gGta2PortSteerRamp * speed / kSoftFullSpeed);
+        if (mag < ramp)
+        {
+            scale = (s32)sqrt((double)mag / ramp * kFullScale * kFullScale);
+            if (scale < kMinScale)
+            {
+                scale = kMinScale;
+            }
+        }
+    }
+    gScaledCar = car;
+    gScale = scale;
+    const s32 key = reversing ? -decision : decision;
+    *bLeftOn = key > 0 ? 1 : 0;
+    *bRightOn = key < 0 ? 1 : 0;
+    gDebug[0] = 1;
+    gDebug[1] = error;
+    gDebug[2] = omega;
+    gDebug[3] = key;
+    gDebug[4] = scale;
+}
diff --git a/port/platform/turret_web.cpp b/port/platform/turret_web.cpp
new file mode 100644
index 0000000..2115555
--- /dev/null
+++ b/port/platform/turret_web.cpp
@@ -0,0 +1,88 @@
+// GTA2 Mobile: aim the tank's turret at an absolute heading (the touch overlay's Fire ring).
+//
+// GTA2 turns a roof turret only while Special + left / right are held
+// (Car_BC::HandleRoofTurretRotation_440D90, the tank at kTankTurretRotSpeed = 20 Ang16 units =
+// 5° per tick, relative to the hull). The overlay instead gives a direction on screen: the
+// camera is top-down and axis-aligned, so that is a world heading, in the same units as the
+// car's own (sprite field_0, 1440 per turn). Once per tick (patch 0029, from
+// Car_BC::HandleUserInput_4418D0) the local player's tank turns its turret toward the target
+// at the same 5° per tick, and keeps it there while the hull turns underneath (the target
+// stays a world heading until it is changed or cleared).
+//
+// gta2_port_set_turret_target(units): 0..1439, -1 = off (the keys work as usual).
+// gta2_port_turret_state(): 4 ints, refreshed every tick for the local player's car:
+//   0 is a tank with a turret   1 turret world heading (units)   2 target (-1 = none)
+//   3 on target (within one step)
+#include <emscripten.h>
+#include "Car_BC.hpp"
+#include "Game_0x40.hpp"
+#include "Ped.hpp"
+#include "Player.hpp"
+#include "ang16.hpp"
+#include "sprite.hpp"
+
+extern "C" {
+s32 gGta2PortTurretTarget = -1;
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_turret_target(int units)
+{
+    gGta2PortTurretTarget = units < 0 ? -1 : ((units % 1440) + 1440) % 1440;
+}
+
+EMSCRIPTEN_KEEPALIVE const s32* gta2_port_turret_state();
+}
+
+namespace
+{
+s32 gState[4] = {0, 0, -1, 0};
+const s32 kTankCannonModel = 148; // objects::tank_cannon_148
+const s32 kStep = 20;             // kTankTurretRotSpeed_677352: 5° per tick
+
+bool IsLocalPlayerCar(Car_BC* car)
+{
+    if (!car || !gGame_0x40_67E008 || !gGame_0x40_67E008->field_38_orf1)
+    {
+        return false;
+    }
+    Ped* local = gGame_0x40_67E008->field_38_orf1->field_2C4_player_ped;
+    return local && local->get_car_416B60() == car;
+}
+} // namespace
+
+extern "C" const s32* gta2_port_turret_state()
+{
+    return gState;
+}
+
+// Called from Car_BC::HandleUserInput_4418D0 (patch 0029), after the game's own turret keys.
+extern "C" void Gta2Port_TurretOverride(Car_BC* car)
+{
+    if (!IsLocalPlayerCar(car))
+    {
+        return;
+    }
+    gState[0] = 0;
+    gState[2] = gGta2PortTurretTarget;
+    gState[3] = 0;
+    Sprite_18* turret = car->IsTank_411900() ? car->field_0_attachments.GetSpriteForModel_5A6A50(kTankCannonModel) : nullptr;
+    if (!turret || !car->field_50_car_sprite)
+    {
+        return;
+    }
+    const s32 hull = car->field_50_car_sprite->field_0.rValue;
+    s32 world = ((hull + turret->field_10_rot.rValue) % 1440 + 1440) % 1440;
+    gState[0] = 1;
+    if (gGta2PortTurretTarget >= 0)
+    {
+        const s32 error = ((gGta2PortTurretTarget - world + 720) % 1440 + 1440) % 1440 - 720;
+        const s32 step = error > kStep ? kStep : error < -kStep ? -kStep : error;
+        if (step != 0)
+        {
+            turret->field_10_rot.rValue = (s16)((((turret->field_10_rot.rValue + step) % 1440) + 1440) % 1440);
+            car->field_B8_turret_rotated = 1; // the turret's motor sound
+            world = ((world + step) % 1440 + 1440) % 1440;
+        }
+        gState[3] = (error >= -kStep && error <= kStep) ? 1 : 0;
+    }
+    gState[1] = world;
+}
diff --git a/port/render/frame.cpp b/port/render/frame.cpp
index a3478f0..2a515cb 100644
--- a/port/render/frame.cpp
+++ b/port/render/frame.cpp
@@ -107,9 +107,30 @@ EMSCRIPTEN_KEEPALIVE void gta2_port_set_interpolation(int on)
     gGta2PortInterpolate = on ? 1 : 0;
 }
 
+// GTA2 Mobile: inset (reference px) kept between the screen edges and the edge-anchored HUD
+// parts, for the notch and the rounded corners of a phone held sideways.
+int32_t gGta2PortHudInset = 0;
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_hud_inset(int refPx)
+{
+    gGta2PortHudInset = refPx < 0 ? 0 : refPx > 200 ? 200 : refPx;
+}
+
 void Gta2Port_SetFrameLayout(int32_t width, int32_t hudOffsetX)
 {
