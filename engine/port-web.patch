 }
 
+// GTA2 Mobile: inset (reference px) kept between the screen edges and the edge-anchored HUD
+// parts, for the notch and the rounded corners of a phone held sideways.
+int32_t gGta2PortHudInset = 0;
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_hud_inset(int refPx)
+{
+    gGta2PortHudInset = refPx < 0 ? 0 : refPx > 200 ? 200 : refPx;
+}
+
 void Gta2Port_SetFrameLayout(int32_t width, int32_t hudOffsetX)
 {
     gFrameWidth = width > 0 ? width : 640;
+    // Hud.cpp (patch 0014) passes (screen − 640)/2 × side, side 0 = left edge, 1 = centred 4:3
+    // box, 2 = right edge. Pull the edge-anchored parts in by the inset, never past the centre.
+    const int32_t half = (gFrameWidth - 640) / 2;
+    const int32_t inset = gGta2PortHudInset < half ? gGta2PortHudInset : half;
+    if (hudOffsetX <= 0)
+    {
+        hudOffsetX += inset; // left
+    }
+    else if (hudOffsetX >= 2 * half && half > 0)
+    {
+        hudOffsetX -= inset; // right
+    }
     gHudOffsetX = static_cast<float>(hudOffsetX);
 }
 
