@@ -178,6 +178,54 @@ EMSCRIPTEN_KEEPALIVE const s32* gta2_dev_find_road()
     return best;
 }
 
+// Test aid (GTA2 Mobile): the largest square of flat open ground (road, pavement or field,
+// flat, air above) at any height: a place to test driving with no walls to scrape. Returns
+// [x, y, z, size] in blocks (the square's top-left and side).
+EMSCRIPTEN_KEEPALIVE const s32* gta2_dev_find_open()
+{
+    static s32 best[4];
+    best[3] = 0;
+    if (!gMap_0x370_6F6268)
+    {
+        return best;
+    }
+    static u8 side[256][256];
+    for (s32 z = 0; z < 7; ++z)
+    {
+        for (s32 y = 0; y < 256; ++y)
+        {
+            for (s32 x = 0; x < 256; ++x)
+            {
+                gmp_block_info* b = gMap_0x370_6F6268->get_block_4DFE10(x, y, z);
+                gmp_block_info* above = gMap_0x370_6F6268->get_block_4DFE10(x, y, z + 1);
+                const bool open = b && (b->field_B_slope_type & 3) != AIR && (b->field_B_slope_type >> 2) == 0 &&
+                    (!above || (above->field_B_slope_type & 3) == AIR);
+                u8 v = 0;
+                if (open)
+                {
+                    v = 1;
+                    if (x && y)
+                    {
+                        const u8 a = side[y - 1][x], l = side[y][x - 1], d = side[y - 1][x - 1];
+                        u8 m = a < l ? a : l;
+                        m = m < d ? m : d;
+                        v = static_cast<u8>(m + 1);
+                    }
+                }
+                side[y][x] = v;
+                if (v > best[3])
+                {
+                    best[0] = x - v + 1;
+                    best[1] = y - v + 1;
+                    best[2] = z;
+                    best[3] = v;
+                }
+            }
+        }
+    }
+    return best;
+}
+
