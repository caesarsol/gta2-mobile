diff --git a/port/platform/mobile_camera_web.cpp b/port/platform/mobile_camera_web.cpp
new file mode 100644
index 0000000..235c662
--- /dev/null
+++ b/port/platform/mobile_camera_web.cpp
@@ -0,0 +1,55 @@
+// GTA2 Mobile camera (mode 2) look-ahead.
+//
+// Mode 2 skips the original's car-velocity camera offset (patch 0026), which put the camera up
+// to ~4 blocks ahead of the car and raised it with speed. Without any offset the camera's
+// follow spring trails a fast car by ~2.8 blocks per block/tick, so at top speed the car
+// drives toward the front edge of the view. This adds a *bounded* look-ahead along the
+// velocity: lead = min(speed × k, max) blocks (k in ticks), which cancels the trailing and
+// puts the car a little behind the centre, leaving more road ahead. Smooth in speed, so no
+// swaying; zero when stopped.
+#include <emscripten.h>
+#include <math.h>
+#include "Car_BC.hpp"
+#include "Fix16_Point.hpp"
+
+extern "C" {
+float gGta2PortCameraLeadK = 7.0f;   // blocks of lead per block/tick of speed (ticks)
+float gGta2PortCameraLeadMax = 3.0f; // blocks
+s32 gGta2PortCamFollowScale = 4;     // follow spring acceleration / top speed multiplier (mode 2)
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_camera_follow(int scale)
+{
+    gGta2PortCamFollowScale = scale < 1 ? 1 : scale > 16 ? 16 : scale;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_camera_lead(float k, float max)
+{
+    gGta2PortCameraLeadK = k < 0.0f ? 0.0f : k > 40.0f ? 40.0f : k;
+    gGta2PortCameraLeadMax = max < 0.0f ? 0.0f : max > 8.0f ? 8.0f : max;
+}
+
+// Called by Camera_0xBC::ApplyCarVelocityCameraOffset_436200 in mode 2 (patch 0028).
+void Gta2Port_MobileCameraLead(Car_BC* pCar, Fix16* pX, Fix16* pY)
+{
+    if (!pCar || pCar->IsTrainModel_403BA0() || gGta2PortCameraLeadK <= 0.0f)
+    {
+        return;
+    }
+    const Fix16_Point v = pCar->get_linvel_43A450(); // blocks per tick
+    const double vx = v.x.mValue / 65536.0;
+    const double vy = v.y.mValue / 65536.0;
+    const double len = sqrt(vx * vx + vy * vy);
+    if (len < 1e-4)
+    {
+        return;
+    }
+    double lead = len * gGta2PortCameraLeadK;
+    if (lead > gGta2PortCameraLeadMax)
+    {
+        lead = gGta2PortCameraLeadMax;
+    }
+    const double f = lead / len;
+    pX->mValue += static_cast<s32>(vx * f * 65536.0);
+    pY->mValue += static_cast<s32>(vy * f * 65536.0);
+}
+}
diff --git a/port/platform/steer_web.cpp b/port/platform/steer_web.cpp
new file mode 100644
index 0000000..ae35331
--- /dev/null
+++ b/port/platform/steer_web.cpp
@@ -0,0 +1,165 @@
+// GTA2 Mobile: steer the local player's car toward a target heading inside the physics tick.
+//
+// The touch overlay's joystick gives a direction of travel, but the game only takes left /
+// right key states, and a car keeps yawing for a few ticks after the key is released (yaw
+// momentum). A controller outside the engine sees the heading a tick late and never the
+// angular velocity, so it hunts around the target. Here, once per tick and with the exact
+// state, the decision is: steer toward the target unless the momentum (angular velocity ×
+// kd ticks) already carries the car there, with a small dead band. Reversing cars have the
+// steering sense inverted, as the engine does for the keys.
+//
+// GTA2's steering is on/off at full lock (CarPhysics_B0::UpdateSteeringAngle_562560), so at
+// speed every correction is a full-lock jab and the car slides. Inside a "soft zone" around the
+// target the key is therefore pulsed: a sigma-delta modulator turns the wanted fraction
+// |predicted| / ramp into a pattern of steering and idle ticks (1/4 of the ticks at a quarter
+// of the ramp), the way a keyboard player taps for small corrections. Beyond the ramp it is
+// full lock, as before.
+//
+// gta2_port_set_steer_target(units): target heading in Ang16 units (0..1439, 4 per degree),
+// -1 = off (the keys steer as usual). gta2_port_set_steer_params(kd, band): momentum look-ahead
+// in ticks and dead band in Ang16 units. gta2_port_set_steer_ramp(units): soft zone width in
+// Ang16 units (0 = always full lock).
+#include <emscripten.h>
+#include "Car_BC.hpp"
+#include "CarPhysics_B0.hpp"
+#include "Game_0x40.hpp"
+#include "Ped.hpp"
+#include "Player.hpp"
+#include "ang16.hpp"
+
+extern "C" {
+s32 gGta2PortSteerTarget = -1;
+s32 gGta2PortSteerKd = 2;   // ticks of momentum look-ahead
+s32 gGta2PortSteerBand = 6; // stop steering within this (Ang16 units; 4 = 1°); restart beyond 2× it
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_target(int units)
+{
+    gGta2PortSteerTarget = units < 0 ? -1 : ((units % 1440) + 1440) % 1440;
+}
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_params(int kd, int band)
+{
+    gGta2PortSteerKd = kd < 0 ? 0 : kd > 30 ? 30 : kd;
+    gGta2PortSteerBand = band < 0 ? 0 : band > 360 ? 360 : band;
+}
+
+s32 gGta2PortSteerRamp = 80; // soft zone: pulse the key while |predicted| < ramp (Ang16 units; 80 = 20°)
+
+EMSCRIPTEN_KEEPALIVE void gta2_port_set_steer_ramp(int units)
+{
+    gGta2PortSteerRamp = units < 0 ? 0 : units > 720 ? 720 : units;
+}
+
+// Debug: [active, error units, angular velocity units/tick, decision -1/0/1]
+EMSCRIPTEN_KEEPALIVE const s32* gta2_port_steer_debug();
+}
+
+namespace
+{
+s32 gDebug[4];
+
+Ped* LocalPlayerPed()
+{
+    if (!gGame_0x40_67E008 || !gGame_0x40_67E008->field_38_orf1)
+    {
+        return nullptr;
+    }
+    return gGame_0x40_67E008->field_38_orf1->field_2C4_player_ped;
+}
+} // namespace
+
+extern "C" const s32* gta2_port_steer_debug()
+{
+    return gDebug;
+}
+
+// Called from Car_BC::HandleUserInput_4418D0 (patch 0027) before the keys are used.
+extern "C" void Gta2Port_SteerOverride(Car_BC* car, char* bLeftOn, char* bRightOn)
+{
+    gDebug[0] = 0;
+    if (gGta2PortSteerTarget < 0 || !car || !car->field_58_physics)
+    {
+        return;
+    }
+    Ped* local = LocalPlayerPed();
+    if (!local || local->get_car_416B60() != car)
+    {
+        return;
+    }
+    CarPhysics_B0* phys = car->field_58_physics;
+    const s32 theta = phys->field_58_theta.rValue;
+    s32 error = gGta2PortSteerTarget - theta; // + = turn left (theta grows)
+    error = ((error + 720) % 1440 + 1440) % 1440 - 720;
+    const s32 omega = phys->field_74_ang_vel_rad.mValue / 71; // Ang16 units per tick
+    // Reversing: the velocity points against the heading (the physics' own test).
+    bool reversing = false;
+    if (!phys->field_40_linvel_1.IsNull())
+    {
+        const Ang16 rel = phys->field_40_linvel_1.atan2_40F790() - phys->field_58_theta;
+        reversing = !(rel <= 360 || rel >= 1080);
+    }
+    // Hysteresis: once the car has settled, small errors are left alone (a tick of steering
+    // always moves it more than the band), until the error grows to two bands.
+    static s32 steering = 0;
+    const s32 predicted = error - omega * gGta2PortSteerKd;
+    const s32 startBand = gGta2PortSteerBand * 2;
+    s32 decision = 0;
+    if (steering != 0)
+    {
+        if (predicted > gGta2PortSteerBand && steering > 0)
+        {
+            decision = 1;
+        }
+        else if (predicted < -gGta2PortSteerBand && steering < 0)
+        {
+            decision = -1;
+        }
+    }
+    else if (predicted > startBand)
+    {
+        decision = 1;
+    }
+    else if (predicted < -startBand)
+    {
+        decision = -1;
+    }
+    steering = decision;
+    // Soft zone: pulse-width the steering by |predicted| / ramp (sigma-delta: the error
+    // accumulator carries the fraction from tick to tick, so the pattern has no long gaps).
+    static s32 pulse = 0;
+    s32 key = decision;
+    if (decision != 0 && gGta2PortSteerRamp > 0)
+    {
+        const s32 mag = predicted < 0 ? -predicted : predicted;
+        if (mag < gGta2PortSteerRamp)
+        {
+            pulse += mag;
+            if (pulse >= gGta2PortSteerRamp)
+            {
+                pulse -= gGta2PortSteerRamp;
+            }
+            else
+            {
+                key = 0;
+            }
+        }
+        else
+        {
+            pulse = 0;
+        }
+    }
+    else
+    {
+        pulse = 0;
+    }
+    if (reversing)
+    {
+        key = -key;
+    }
+    *bLeftOn = key > 0 ? 1 : 0;
+    *bRightOn = key < 0 ? 1 : 0;
+    gDebug[0] = 1;
+    gDebug[1] = error;
+    gDebug[2] = omega;
+    gDebug[3] = key; // the key actually sent this tick (0 on a pulsed-off tick)
+}
