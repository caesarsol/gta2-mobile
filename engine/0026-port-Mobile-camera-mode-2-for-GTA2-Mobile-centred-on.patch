+++ b/Source/port_modern_camera.cpp
@@ -165,6 +165,18 @@ void Gta2Port_ModernCameraTick(Camera_0xBC* cam)
     s->canonical = cam->field_98_cam_pos2;
 }
 
+// The camera was moved after its update (the Mobile camera's post-tick pin): keep the
+// position its copies are recognised by in step, or PresentedCameraZ falls back to the raw
+// height for the rest of the tick.
+void Gta2Port_ModernCameraMoved(const Camera_0xBC* cam)
+{
+    ModernState* s = Find(cam, false);
+    if (s)
+    {
+        s->canonical = cam->field_98_cam_pos2;
+    }
+}
+
 // The height the camera is drawn from: Modern's filtered height (plus the
 // player's bias) for a camera that is, or is a copy of, an updated camera.
 Fix16 Gta2Port_PresentedCameraZ(const Camera_0xBC* cam)
